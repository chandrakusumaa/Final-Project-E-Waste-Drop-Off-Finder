              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan",
            "body": {
              "mode": "raw",
              "raw": "{\"nama\":",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error memiliki pesan', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Nonaktifkan titik B",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan/{{idB}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"nonaktif\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titik nonaktif', () => pm.expect(pm.response.json().data.status).to.eql('nonaktif'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter aktif sekarang kosong",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan?kecamatan=%20TeBeT%20&barang=%20MONITOR%20&status=aktif"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Daftar kosong', () => pm.expect(pm.response.json().data).to.eql([]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Persistensi dan pembersihan",
      "item": [
        {
          "name": "Status masih tersimpan setelah restart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan/{{idB}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titik tetap nonaktif', () => pm.expect(pm.response.json().data.status).to.eql('nonaktif'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hapus titik B",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan/{{idB}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('Body kosong', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail titik B setelah dihapus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/titik-pengumpulan/{{idB}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Pesan titik tidak ditemukan', () => pm.expect(pm.response.json().message).to.eql('Titik pengumpulan tidak ditemukan.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hapus titik A",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
